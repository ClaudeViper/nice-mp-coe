# ─────────────────────────────────────────────────────────────────────────────
# NICE Media Processing CoE — environment variables template
# Copy to .env and fill in your real values:
#   cp .env.example .env
# NEVER commit the filled-in .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL / Supabase ────────────────────────────────────────────────────
# Find both URLs at: Supabase Dashboard → your project → Settings → Database
#
# DATABASE_URL  = Transaction Pooler URL  (port 6543) — used by the app at runtime
# DIRECT_URL    = Direct Connection URL   (port 5432) — used only by Prisma migrate
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

# ── Anthropic (Claude AI) ────────────────────────────────────────────────────
# Create a key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-api03-REPLACE_ME"

# ── Vendor API Keys (optional — for real evaluations, not simulation) ─────────
# Keys are entered at runtime in the Evaluate wizard. You can optionally
# pre-set them here so they are available server-side as env vars.
#
# ── STT ──────────────────────────────────────────────────────────────────────
# Deepgram         — $200 free credit, no credit card: https://console.deepgram.com/signup
DEEPGRAM_API_KEY=""
# AssemblyAI       — free dev tier: https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=""
# OpenAI Whisper   — pay-as-you-go ($0.006/min): https://platform.openai.com/signup
OPENAI_API_KEY=""
# Google Cloud STT — 60 min/month free + $300 credit: https://cloud.google.com/free
GOOGLE_API_KEY=""
# Azure Speech     — 5 hours/month free: https://azure.microsoft.com/free/cognitive-services/
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="eastus"
# NVIDIA NIM       — 1,000 free calls/month: https://build.nvidia.com/explore/speech
NVIDIA_API_KEY=""
# Speechmatics     — trial credits: https://portal.speechmatics.com/signup
SPEECHMATICS_API_KEY=""
# Meta SeamlessM4T — free via HuggingFace: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=""

# ── TTS ──────────────────────────────────────────────────────────────────────
# ElevenLabs       — 10,000 chars/month free: https://elevenlabs.io/app/sign-up
ELEVENLABS_API_KEY=""
# OpenAI TTS       — pay-as-you-go ($15/1M chars, same key as OPENAI_API_KEY above)
# Google TTS       — 1M standard chars/month free (same key as GOOGLE_API_KEY above)
# Azure TTS        — 500K chars/month free (same key as AZURE_SPEECH_KEY above)
# Coqui            — open-source, self-hosted or HuggingFace (same as HUGGINGFACE_API_KEY)

# ── V2V ──────────────────────────────────────────────────────────────────────
# VAPI             — $10 free credit: https://vapi.ai
VAPI_API_KEY=""
# Retell AI        — free credits: https://app.retellai.com/sign-up
RETELL_API_KEY=""
# Hume AI          — free developer tier: https://platform.hume.ai/sign-up
HUME_API_KEY=""
