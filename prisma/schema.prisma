// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── News ────────────────────────────────────────────────────────────────────

enum NewsCategory {
  STT
  TTS
  V2V
  General
  Research
}

model NewsItem {
  id             String       @id @default(cuid())
  title          String
  date           DateTime
  source         String
  url            String       @unique
  summary        String
  category       NewsCategory
  relevanceScore Int          @map("relevance_score")
  tags           String[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([category])
  @@index([relevanceScore])
  @@index([date])
  @@map("news_items")
}

// ─── Benchmarks ──────────────────────────────────────────────────────────────

enum BenchmarkType {
  STT
  TTS
  V2V
}

model Vendor {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  website     String?
  pricingUrl  String?  @map("pricing_url")
  docsUrl     String?  @map("docs_url")
  isTracked   Boolean  @default(true) @map("is_tracked")
  description String?
  logoUrl     String?  @map("logo_url")
  foundedYear Int?     @map("founded_year")
  hqLocation  String?  @map("hq_location")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  benchmarkResults     BenchmarkResult[]
  products             VendorProduct[]
  deploymentOptions    VendorDeploymentOption[]
  securityCerts        VendorSecurityCert[]
  supportedLanguages   VendorLanguage[]
  pricingTiers         VendorPricingTier[]
  niceCompatibility    NiceCompatibility?
  registryRunLogs      VendorRegistryRunLog[]
  evaluations          Evaluation[]
  deploymentGuidelines DeploymentGuideline[]

  @@map("vendors")
}

model BenchmarkResult {
  id            String        @id @default(cuid())
  vendorId      String        @map("vendor_id")
  modelName     String        @map("model_name")
  benchmarkType BenchmarkType @map("benchmark_type")
  sourceName    String        @map("source_name")
  sourceUrl     String        @map("source_url")
  metricName    String        @map("metric_name")
  metricValue   Decimal       @map("metric_value") @db.Decimal(10, 4)
  metricUnit    String        @map("metric_unit")
  dataset       String        @default("ALL")
  language      String        @default("en")
  collectedAt   DateTime      @default(now()) @map("collected_at")
  rawData       Json?         @map("raw_data")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, modelName, metricName, dataset, language, sourceName])
  @@index([vendorId])
  @@index([benchmarkType])
  @@index([metricName])
  @@map("benchmark_results")
}

model BenchmarkRunLog {
  id               String    @id @default(cuid())
  status           String
  sourcesChecked   Int       @default(0) @map("sources_checked")
  resultsUpserted  Int       @default(0) @map("results_upserted")
  resultsUnchanged Int       @default(0) @map("results_unchanged")
  errors           Json?
  startedAt        DateTime  @map("started_at")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("benchmark_run_log")
}

// ─── Vendor Registry ────────────────────────────────────────────────────────

enum ProductCategory {
  STT
  TTS
  V2V
  NLU
  Conversational
  Platform
}

model VendorProduct {
  id          String          @id @default(cuid())
  vendorId    String          @map("vendor_id")
  name        String
  slug        String
  category    ProductCategory
  version     String?
  description String?
  apiEndpoint String?         @map("api_endpoint")
  isGa        Boolean         @default(true) @map("is_ga")
  releasedAt  DateTime?       @map("released_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, slug])
  @@index([vendorId])
  @@index([category])
  @@map("vendor_products")
}

enum DeploymentType {
  Cloud
  OnPrem
  Hybrid
  Edge
}

model VendorDeploymentOption {
  id         String         @id @default(cuid())
  vendorId   String         @map("vendor_id")
  type       DeploymentType
  details    String?
  regions    String[]
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, type])
  @@index([vendorId])
  @@map("vendor_deployment_options")
}

model VendorSecurityCert {
  id              String    @id @default(cuid())
  vendorId        String    @map("vendor_id")
  certName        String    @map("cert_name")
  certBody        String?   @map("cert_body")
  issuedAt        DateTime? @map("issued_at")
  expiresAt       DateTime? @map("expires_at")
  verificationUrl String?   @map("verification_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, certName])
  @@index([vendorId])
  @@map("vendor_security_certs")
}

model VendorLanguage {
  id         String   @id @default(cuid())
  vendorId   String   @map("vendor_id")
  language   String
  langCode   String   @map("lang_code")
  accents    String[]
  category   ProductCategory
  createdAt  DateTime @default(now()) @map("created_at")

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, langCode, category])
  @@index([vendorId])
  @@map("vendor_languages")
}

model VendorPricingTier {
  id              String   @id @default(cuid())
  vendorId        String   @map("vendor_id")
  tierName        String   @map("tier_name")
  category        ProductCategory
  pricePerUnit    Decimal  @map("price_per_unit") @db.Decimal(10, 6)
  unit            String
  monthlyMinimum  Decimal? @map("monthly_minimum") @db.Decimal(10, 2)
  volumeDiscount  String?  @map("volume_discount")
  commitmentTerms String?  @map("commitment_terms")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, tierName, category])
  @@index([vendorId])
  @@map("vendor_pricing_tiers")
}

model NiceCompatibility {
  id                       String   @id @default(cuid())
  vendorId                 String   @unique @map("vendor_id")
  cxoneIntegrationStatus   String   @map("cxone_integration_status")
  integrationMethod        String?  @map("integration_method")
  certifiedVersion         String?  @map("certified_version")
  buildVsBuyScore          Int      @map("build_vs_buy_score")
  buildVsBuyRationale      String?  @map("build_vs_buy_rationale")
  migrationComplexity      String?  @map("migration_complexity")
  estimatedIntegrationDays Int?     @map("estimated_integration_days")
  notes                    String?
  assessedAt               DateTime @default(now()) @map("assessed_at")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@map("nice_compatibility")
}

model VendorRegistryRunLog {
  id               String    @id @default(cuid())
  vendorId         String?   @map("vendor_id")
  status           String
  vendorsProcessed Int       @default(0) @map("vendors_processed")
  fieldsUpdated    Int       @default(0) @map("fields_updated")
  errors           Json?
  startedAt        DateTime  @map("started_at")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  vendor Vendor? @relation(fields: [vendorId], references: [id])

  @@map("vendor_registry_run_log")
}

// ─── Deployment Guidelines ───────────────────────────────────────────────────

model DeploymentGuideline {
  id          String    @id @default(cuid())
  vendorId    String    @map("vendor_id")
  /// null = vendor-level guideline; set to product slug for per-model guidelines
  productSlug String?   @map("product_slug")
  content     String    @db.Text
  status      String    @default("Completed") // Generating | Completed | Failed
  generatedAt DateTime  @default(now()) @map("generated_at")
  errorMsg    String?   @map("error_msg")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, productSlug])
  @@index([vendorId])
  @@map("deployment_guidelines")
}

// ─── Evaluations ────────────────────────────────────────────────────────────

enum EvaluationStatus {
  Pending
  Running
  Completed
  Failed
  Cancelled
}

model Evaluation {
  id              String           @id @default(cuid())
  vendorId        String           @map("vendor_id")
  evaluationType  BenchmarkType    @map("evaluation_type")
  modelName       String           @map("model_name")
  status          EvaluationStatus @default(Pending)
  config          Json
  dataset         String           @default("standard")
  language        String           @default("en")
  totalSamples    Int              @default(0) @map("total_samples")
  processedSamples Int             @default(0) @map("processed_samples")
  startedAt       DateTime?        @map("started_at")
  completedAt     DateTime?        @map("completed_at")
  errorMessage    String?          @map("error_message")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  vendor  Vendor             @relation(fields: [vendorId], references: [id])
  results EvaluationResult[]

  @@index([vendorId])
  @@index([evaluationType])
  @@index([status])
  @@map("evaluations")
}

model EvaluationResult {
  id            String   @id @default(cuid())
  evaluationId  String   @map("evaluation_id")
  metricName    String   @map("metric_name")
  metricValue   Decimal  @map("metric_value") @db.Decimal(10, 4)
  metricUnit    String   @map("metric_unit")
  sampleId      String?  @map("sample_id")
  details       Json?
  createdAt     DateTime @default(now()) @map("created_at")

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
  @@index([metricName])
  @@map("evaluation_results")
}

model EvaluationDataset {
  id            String        @id @default(cuid())
  name          String        @unique
  slug          String        @unique
  type          BenchmarkType
  description   String?
  sampleCount   Int           @map("sample_count")
  language      String        @default("en")
  samples       Json
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([type])
  @@map("evaluation_datasets")
}

// ─── Reports ────────────────────────────────────────────────────────────────

enum ReportType {
  MonthlyLandscape
  VendorComparison
  EvaluationSummary
  BuildVsBuy
  IntegrationReadiness
}

enum ReportStatus {
  Generating
  Completed
  Failed
}

model Report {
  id          String       @id @default(cuid())
  type        ReportType
  title       String
  status      ReportStatus @default(Generating)
  summary     String?
  content     String?
  contentHtml String?      @map("content_html")
  metadata    Json?
  generatedBy String?      @map("generated_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("reports")
}
